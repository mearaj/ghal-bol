# GhalBol Chat — development environment.
# Loaded by scripts/load-ghalbol-env.sh before dev runs; baked by build.rs.
# GHALBOL_* keys are what the app runtime reads (see main.rs env::var).

GHALBOL_ENV=development
GHALBOL_APP_ID=com.ghalbol.debug
GHALBOL_APP_LABEL="Ghal Bol Dev"
GHALBOL_COORD_URLS=["https://coord1.ghalbol.com:8443"]
GHALBOL_DELIVERY_URL=wss://delivery.ghalbol.com:55003
GHALBOL_VERBOSE_LOG=1

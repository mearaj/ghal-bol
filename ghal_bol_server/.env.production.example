# Copy to ghal_bol_server/.env.production (gitignored). GCP deploy — deploy_server.sh.
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_INSTANCE=your-vm-instance-name
GCP_USER=your-linux-username-on-vm

# Post-deploy verify (from your laptop)
COORD_URL=https://coord.ghalbol.com
RELAY_HOST=coord.ghalbol.com
RELAY_PORT=4002

# Rendered into systemd on deploy (ghal-bol-server.service + relay-egress-cap.service)
GHAL_BOL_SERVER_LISTEN=127.0.0.1:8765
GHAL_BOL_RELAY_LISTEN=0.0.0.0:4002
GHAL_BOL_RELAY_PUBLIC_HOST=coord.ghalbol.com
# Linux tc egress cap for relay TCP (Mbit/s; 0 = no cap)
GHAL_BOL_RELAY_EGRESS_MBIT=10
# Per-circuit relay byte cap in the binary (0 = unlimited)
GHAL_BOL_RELAY_MAX_CIRCUIT_BYTES=2147483648
GHAL_BOL_RELAY_MAX_CIRCUITS_PER_PEER=16

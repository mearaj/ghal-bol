# User systemd unit — no root. Installed by install_coord1_home.sh to ~/.config/systemd/user/

[Unit]
Description=Ghal Bol coordination server (coord1.ghalbol.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=REPLACE_COORD1_BIN
Environment=GHAL_BOL_SERVER_LISTEN=REPLACE_GHAL_BOL_SERVER_LISTEN
Environment=GHAL_BOL_SERVER_DB=/home/REPLACE_COORD1_USER/.local/share/com.ghalbol.coord/ghalbol_server
Environment=RUST_LOG=info
Environment=GHAL_BOL_RELAY_LISTEN=REPLACE_GHAL_BOL_RELAY_LISTEN
Environment=GHAL_BOL_RELAY_DYNAMIC=REPLACE_GHAL_BOL_RELAY_DYNAMIC
Environment=GHAL_BOL_RELAY_UPNP=REPLACE_GHAL_BOL_RELAY_UPNP
Environment=GHAL_BOL_RELAY_PUBLIC_HOST=REPLACE_GHAL_BOL_RELAY_PUBLIC_HOST
Environment=GHAL_BOL_RELAY_MAX_CIRCUIT_BYTES=REPLACE_GHAL_BOL_RELAY_MAX_CIRCUIT_BYTES
Environment=GHAL_BOL_RELAY_MAX_CIRCUITS_PER_PEER=REPLACE_GHAL_BOL_RELAY_MAX_CIRCUITS_PER_PEER
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

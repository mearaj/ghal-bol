[Unit]
Description=Ghal Bol relay egress bandwidth cap (tc)
After=network-online.target
Before=ghal-bol-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Environment=GHAL_BOL_RELAY_EGRESS_MBIT=REPLACE_GHAL_BOL_RELAY_EGRESS_MBIT
Environment=GHAL_BOL_RELAY_LISTEN=REPLACE_GHAL_BOL_RELAY_LISTEN
ExecStart=/home/REPLACE_VM_USER/relay-egress-tc.sh

[Install]
WantedBy=multi-user.target

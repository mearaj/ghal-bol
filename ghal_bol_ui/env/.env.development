# Debug builds — bundled on `flutter run` (debug). Rebuild after changing.
GHAL_BOL_COORD_URLS=https://coord.ghalbol.com
# Full libp2p flow on the terminal: forwards Rust `debug` lines into the App log too
# (info+ already shows). Plumbed to the Linux daemon spawn env and the Android :p2p
# service (Os.setenv). 1|true|yes|on to enable; remove/0 for quiet info-only logs.
GHAL_BOL_VERBOSE_LOG=1
# Plain HTTP — no TLS on local ghal_bol_server :8765. Port-forward 8765 + 4002 on router.
#GHAL_BOL_COORD_URLS=["http://117.212.84.122:8765"]
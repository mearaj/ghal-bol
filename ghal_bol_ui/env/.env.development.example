# Copy to env/.env.development (gitignored) and edit. Rebuild after changes.
# Home coord1 (gotigin): https://coord1.ghalbol.com:8443
# GCP coord: ["https://coord.ghalbol.com"]
GHAL_BOL_COORD_URLS=["https://coord1.ghalbol.com:8443"]
# When set, text DMs use ghal_bol_delivery (libp2p kept for calls only).
# WAN WSS — same model as coord1 https://coord1.ghalbol.com:8443 (nginx :55003 -> 127.0.0.1:8770).
GHAL_BOL_DELIVERY_URL=wss://delivery.ghalbol.com:55003
# Linux desktop on the delivery host only (ignored on Android/iOS):
# GHAL_BOL_DELIVERY_URL_LOCAL=ws://127.0.0.1:8770
GHAL_BOL_VERBOSE_LOG=1

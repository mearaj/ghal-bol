# Development coordination servers (copy to .env.development or edit this file).
# Used automatically on `flutter run` (debug). Not used in release builds.
#
# Copy once (optional local override, gitignored):
#   cp env/.env.development.example env/.env.development
#
GHAL_BOL_COORD_URLS=https://shuffling-glandular-traverse.ngrok-free.dev
# Multiple servers (comma, space, tab, or newline — no brackets required):
# GHAL_BOL_COORD_URLS=https://coord-a.example.com, https://coord-b.example.com
# GHAL_BOL_COORD_INSECURE_TLS=false

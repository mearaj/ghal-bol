# Development coordination server (copy to .env.development or edit this file).
# Used automatically on `flutter run` (debug). Not used in release builds.
#
# Copy once (optional local override, gitignored):
#   cp env/.env.development.example env/.env.development
#
GHAL_BOL_COORD_URL=https://shuffling-glandular-traverse.ngrok-free.dev
# Set true only for self-signed HTTPS (not typical for ngrok).
# GHAL_BOL_COORD_INSECURE_TLS=false

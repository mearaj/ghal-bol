<?xml version="1.0" encoding="utf-8"?>
<!-- Dev: coordination server is HTTP on LAN (192.168.x). Production should use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

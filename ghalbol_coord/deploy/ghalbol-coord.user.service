# User systemd unit — no /usr, /var, or /etc paths.
#
# Install (paths use your home directory only):
#   mkdir -p ~/.config/systemd/user
#   sed "s|@WORKSPACE@|$PWD/../../..|" ghalbol_coord/deploy/ghalbol-coord.user.service \
#     > ~/.config/systemd/user/ghalbol-coord.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ghalbol-coord
#
# Replace @WORKSPACE@ with the absolute path to the repo root (directory that contains Cargo.toml).

[Unit]
Description=Ghal Bol coordination server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
ExecStart=@WORKSPACE@/target/release/ghalbol_coord
Environment=GHALBOL_COORD_LISTEN=127.0.0.1:8765
Environment=GHALBOL_COORD_DB=%h/.local/share/com.ghalbol.coord/ghalbol_coord
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

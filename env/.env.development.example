# Copy to env/.env.development (gitignored) and edit. Rebuild after changes.
# Home coord1 (gotigin): https://coord1.ghalbol.com:8443
# GCP coord: ["https://coord.ghalbol.com"]
GHALBOL_COORD_URLS=["https://coord1.ghalbol.com:8443"]
# When set, text DMs use ghalbol_delivery (WAN mailbox). Calls still use native connect + coord bridge.
# WAN WSS — same model as coord1 https://coord1.ghalbol.com:8443 (nginx :55003 -> 127.0.0.1:8770).
GHALBOL_DELIVERY_URL=wss://delivery.ghalbol.com:55003
GHALBOL_VERBOSE_LOG=1

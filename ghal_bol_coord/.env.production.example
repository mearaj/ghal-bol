# Copy to ghal_bol_coord/.env.production (gitignored). GCP deploy — deploy_server.sh.
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_INSTANCE=your-vm-instance-name
GCP_USER=your-linux-username-on-vm

# Post-deploy verify (from your laptop)
COORD_URL=https://coord.ghalbol.com

# Rendered into systemd on deploy (ghal-bol-coord.service)
GHAL_BOL_COORD_LISTEN=127.0.0.1:8765
